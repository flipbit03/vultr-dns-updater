[Unit]
Description=Vultr DNS Updater
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User={{ user }}
ExecStart={{ home }}/.local/share/uv/tools/vultr-dns-updater/bin/vultr-dns update --config {{ home }}/.config/vultr-dns-updater/config.toml

[Install]
WantedBy=multi-user.target
